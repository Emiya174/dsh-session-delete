{
  "name": "@local/dsh-session-delete-live",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "description": "Add a Delete session action to the DSH session context menu.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Emiya174/dsh-session-delete.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}



